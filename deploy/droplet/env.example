# Copy to repository root as .env.droplet; chmod 600 .env.droplet.
RELEASE_TAG=prototype
APP_NAME=Assina
APP_DOMAIN=assinaturas.example.com
ACME_EMAIL=admin@example.com
APP_KEY=
DB_PASSWORD=
APP_LOCALE=pt_BR
APP_FALLBACK_LOCALE=en
APP_MAINTENANCE_DRIVER=file
PREVIEW_USER=preview
# Paste bcrypt hash here, enclosed in single quotes to preserve dollar signs.
PREVIEW_PASSWORD_HASH=''
# SMTP provider: no local mail server and no Mailpit exposed on the Droplet.
MAIL_MAILER=smtp
MAIL_SCHEME=smtps
MAIL_HOST=
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=Assina
TIMESTAMP_DRIVER=disabled
